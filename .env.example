# XHS Audit 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==========================================
# OpenAI API 配置 (必填)
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# 如果使用Azure OpenAI，请取消注释并配置:
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2023-05-15

# ==========================================
# 数据库配置 (可选，默认使用docker-compose配置)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xhs_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==========================================
# Redis配置 (可选，默认使用docker-compose配置)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Spring AI 模型配置
# ==========================================
# 模型选择: gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo

# 温度 (0-2): 0=确定性, 2=创造性
OPENAI_TEMPERATURE=0.3

# 最大Token数
OPENAI_MAX_TOKENS=2000

# ==========================================
# 应用配置
# ==========================================
# 服务器端口
SERVER_PORT=8080

# 日志级别: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ==========================================
# Playwright配置
# ==========================================
# 浏览器实例池大小
PLAYWRIGHT_POOL_SIZE=3

# 页面加载超时 (毫秒)
PLAYWRIGHT_TIMEOUT=10000

# ==========================================
# 缓存配置
# ==========================================
# Redis缓存TTL (秒)
REDIS_CACHE_TTL=86400

# Caffeine本地缓存最大大小
CAFFEINE_MAX_SIZE=1000

# Caffeine缓存过期时间 (分钟)
CAFFEINE_EXPIRE_MINUTES=10

# ==========================================
# 审核配置
# ==========================================
# 重试次数
CRAWLER_MAX_RETRY=3

# 批量处理最大并发数
BATCH_MAX_CONCURRENCY=10

# ==========================================
# 监控配置 (Actuator)
# ==========================================
# 是否启用Prometheus指标
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# 是否暴露所有Actuator端点
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# ==========================================
# 开发/测试配置
# ==========================================
# Spring Profile: dev, test, prod
SPRING_PROFILES_ACTIVE=dev

# 是否启用SQL日志
SHOW_SQL=false

# 是否格式化SQL
FORMAT_SQL=true

# ==========================================
# 安全配置 (可选)
# ==========================================
# JWT密钥 (如果启用认证)
# JWT_SECRET=your-secret-key-here

# ==========================================
# 第三方服务配置 (可选)
# ==========================================
# Sentry错误追踪 (可选)
# SENTRY_DSN=https://your-sentry-dsn

# ==========================================
# 使用说明
# ==========================================
# 1. 复制此文件: cp .env.example .env
# 2. 填入实际的OpenAI API Key
# 3. 根据需要调整其他配置
# 4. 启动服务: mvn spring-boot:run
#
# 注意: .env文件已在.gitignore中,不会被提交到Git仓库
